{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdlc.local/schemas/captures/assumption.capture.schema.json",
  "title": "Assumption Capture Payload",
  "description": "Contract between capture interfaces (Pages app / Issue Form) and tools/ingest_capture.py. Untrusted input: strictly bounded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "assumption"],
  "properties": {
    "kind": { "const": "assumption" },
    "version": { "const": 1 },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "validation_plan"],
      "properties": {
        "statement": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "validation_plan": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "title": { "type": "string", "maxLength": 140 },
        "domain": { "type": "string", "maxLength": 60 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "impact": { "type": "string", "maxLength": 4000 },
        "notes": { "type": "string", "maxLength": 4000 }
      }
    },
    "underpins": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(REQ|CON|DEC)-[0-9]{4}$" }
    }
  }
}
