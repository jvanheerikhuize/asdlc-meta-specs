{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asdlc.local/schemas/captures/decision.capture.schema.json",
  "title": "Decision Capture Payload",
  "description": "Contract between capture interfaces (Pages app / Issue Form) and tools/ingest_capture.py for recording architectural / design decisions (ADRs).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "decision", "satisfies"],
  "properties": {
    "kind": { "const": "decision" },
    "version": { "const": 1 },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "title": { "type": "string", "maxLength": 140 },
        "domain": { "type": "string", "maxLength": 60 },
        "context": { "type": "string", "maxLength": 4000 },
        "alternatives": { "type": "string", "maxLength": 4000 },
        "consequences": { "type": "string", "maxLength": 4000 },
        "notes": { "type": "string", "maxLength": 4000 }
      }
    },
    "satisfies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(REQ|CON)-[0-9]{4}$" }
    },
    "underpinned_by": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(FCT|ASM)-[0-9]{4}$" }
    },
    "new_assumptions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement"],
        "properties": {
          "statement": { "type": "string", "minLength": 5, "maxLength": 1000 },
          "risk": { "enum": ["low", "medium", "high", "critical"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "supersedes": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^DEC-[0-9]{4}$" }
    }
  },
  "anyOf": [
    { "required": ["underpinned_by"], "properties": { "underpinned_by": { "minItems": 1 } } },
    { "required": ["new_assumptions"], "properties": { "new_assumptions": { "minItems": 1 } } }
  ]
}
